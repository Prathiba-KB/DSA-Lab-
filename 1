class Student:
    def __init__(self, rollno, name, course):
        self.rollno = rollno
        self.name = name
        self.course = course

    def display(self):
        print("My Roll Number is " + str(self.rollno))
        print("My Name is " + str(self.name))
        print("My Course is " + str(self.course))


s1 = Student(101, "John", "AI&DS")
s1.display()

s2 = Student(102, "Raj", "CSBS")
s2.display()
